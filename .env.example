# Application Configuration
APP_NAME="Supply Chain Traceability System"
APP_ENV="development"
DEBUG=true
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
API_V1_PREFIX="/api/v1"
CORS_ORIGINS="*"

# Dataset Configuration
DATASET_PATH="/home/praneshg/Downloads/dataset/EPCIS-synthetic-food-supply-chain-dataset-main/synthetic-food-supply-chain-dataset.json"

# MongoDB Configuration (Primary Operational / Document Store)
MONGO_URI="mongodb://localhost:27017"
MONGO_DB_NAME="supply_trace"
MONGO_TIMEOUT_MS=5000

# Neo4j Configuration (Provenance Graph Store)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="tracepassword"

# Redis Configuration (Query & QR Cache Layer)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL_SECONDS=900
REDIS_TIMEOUT_SECONDS=2
